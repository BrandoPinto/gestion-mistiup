# Plantilla de .env para producción (cPanel). Copiar como .env en el servidor y completar.
# Nunca subir el .env real a ningún repositorio ni compartirlo por chat/correo.

APP_NAME=Mistiup
APP_ENV=production
APP_DEBUG=false
# Se genera en el servidor con: php artisan key:generate
APP_KEY=
APP_URL=https://gestion.tudominio.com

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE
APP_MAINTENANCE_DRIVER=file
BUSINESS_TIMEZONE=America/Lima

BCRYPT_ROUNDS=12

# Logs diarios, se conservan 14 días. "warning" evita llenar el disco con detalle de depuración.
LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null

# Base de datos creada en cPanel > Bases de datos MySQL (usuario propio, solo con privilegios sobre esta base).
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cpaneluser_mistiup
DB_USERNAME=cpaneluser_mistiup
DB_PASSWORD=

# Sesiones en base de datos; cookie solo por HTTPS, sin acceso desde JavaScript.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

# Sin colas en segundo plano: todo se ejecuta en la petición o en el cron del scheduler.
QUEUE_CONNECTION=sync
CACHE_STORE=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# El sistema no envía correos en v1 (los recordatorios son internos). Se deja en log.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@tudominio.com"
MAIL_FROM_NAME="${APP_NAME}"

# Solo si el sitio está detrás de un proxy como Cloudflare. Vacío = no confiar en X-Forwarded-For.
TRUSTED_PROXIES=

# Días de anticipación por defecto (se puede cambiar luego desde Configuración > Cobros).
BILLING_CHARGE_LEAD_DAYS=45

INERTIA_SSR_ENABLED=false
VITE_APP_NAME="${APP_NAME}"

# Administrador inicial (solo para "php artisan db:seed --force" la primera vez). Borrar la contraseña después.
ADMIN_NAME="Administrador"
ADMIN_EMAIL=
ADMIN_PASSWORD=
